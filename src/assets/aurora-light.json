				"foreground": "oklch(0.5679 0.2113 276.7065)"
			}
		},
		{
			"scope": "constant.numeric",
			"settings": {
				"foreground": "oklch(0.4509 0.1758 279.3838)"
			}
		},
		{
			"scope": ["constant.language.boolean", "constant.language.null"],
			"settings": {
				"foreground": "oklch(0.5417 0.179 288.0332)"
			}
		},
		{
			"scope": "punctuation",
			"settings": {
				"foreground": "oklch(0.4143 0.1039 288.1742)"
			}
		}
	]
