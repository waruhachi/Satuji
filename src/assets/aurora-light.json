{
	"name": "aurora-light",
	"displayName": "Aurora Light",
	"type": "light",
	"semanticHighlighting": false,

	"colors": {
		"editor.background": "oklch(0.973 0.0133 286.1503)",
		"editor.foreground": "oklch(0.3015 0.0572 282.4176)",
		"editor.selectionBackground": "oklch(0.5417 0.179 288.0332 / 0.25)",
		"editorCursor.foreground": "oklch(0.5417 0.179 288.0332)",
		"editorIndentGuide.background": "oklch(0.9115 0.0216 285.9625)",
		"editorIndentGuide.activeBackground": "oklch(0.5417 0.179 288.0332)"
	},

	"tokenColors": [
